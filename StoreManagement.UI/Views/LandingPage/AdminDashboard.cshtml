@model IEnumerable<StoreManagement.Common.DTOs.User>
@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Management - Admin</title>

    <!-- Bootstrap 5.3 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Google Fonts - Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- DataTables + Bootstrap 5 + Responsive + Buttons -->
    <link href="https://cdn.datatables.net/2.3.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.bootstrap5.min.css" rel="stylesheet">

    <style>
        :root {
            --vz-primary: #405189;
            --vz-primary-rgb: 64, 81, 137;
            --vz-success: #0ab39c;
            --vz-success-rgb: 10, 179, 156;
            --vz-secondary: #74788d;
            --vz-light: #f3f6f9;
            --vz-body-bg: #f3f6f9;
            --vz-card-bg: #ffffff;
            --vz-danger: #f06548;
        }

        [data-bs-theme="dark"] {
            --vz-body-bg: #0f1419;
            --vz-card-bg: #1c2431;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--vz-body-bg);
            color: #364a63;
            min-height: 100vh;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            transition: all 0.25s ease;
            overflow: hidden;
        }

            .card:hover {
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                transform: translateY(-3px);
            }

        /* DataTables custom styling */
        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: var(--vz-primary) !important;
            border-color: var(--vz-primary) !important;
            color: white !important;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid rgba(var(--vz-primary-rgb), 0.3);
            border-radius: 6px;
        }

            .dataTables_wrapper .dataTables_filter input:focus {
                border-color: var(--vz-primary);
                box-shadow: 0 0 0 0.25rem rgba(var(--vz-primary-rgb), 0.15);
            }

        .table thead th {
            background-color: rgba(var(--vz-primary-rgb), 0.05);
            color: var(--vz-primary);
            font-weight: 600;
            border-bottom: 2px solid rgba(var(--vz-primary-rgb), 0.1);
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .table tbody tr:hover {
            background-color: rgba(var(--vz-primary-rgb), 0.03);
        }

        .badge-role {
            background-color: rgba(var(--vz-secondary), 0.15);
            color: var(--vz-secondary);
            font-weight: 500;
        }

        .status-badge {
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .status-approved {
            background-color: rgba(var(--vz-success-rgb), 0.15);
            color: var(--vz-success);
            border: 1px solid rgba(var(--vz-success-rgb), 0.3);
        }

        .status-pending {
            background-color: rgba(249, 192, 0, 0.15);
            color: #f4b731;
            border: 1px solid rgba(249, 192, 0, 0.3);
        }

        .btn-approve {
            transition: all 0.3s ease;
        }

            .btn-approve:hover {
                transform: translateY(-2px);
            }

        .header-section {
            border-bottom: 1px solid rgba(0,0,0,0.07);
            padding-bottom: 1.25rem;
            margin-bottom: 2rem;
        }

        h2 {
            font-weight: 700;
            color: #212529;
        }

        .back-link {
            color: var(--vz-primary);
            font-weight: 500;
        }

            .back-link:hover {
                color: #36407a;
                text-decoration: underline;
            }

        /* Buttons styling to match Velzon theme */
        .dt-button {
            background-color: var(--vz-primary) !important;
            color: white !important;
            border: none !important;
            border-radius: 6px !important;
            padding: 0.5rem 1rem !important;
            margin-right: 0.5rem !important;
            font-size: 0.9rem !important;
            transition: all 0.2s ease !important;
        }

            .dt-button:hover {
                background-color: #36407a !important;
                transform: translateY(-1px) !important;
                box-shadow: 0 4px 10px rgba(64,81,137,0.3) !important;
            }

        .dt-button-collection .dt-button {
            background-color: white !important;
            color: #364a63 !important;
        }

            .dt-button-collection .dt-button:hover {
                background-color: var(--vz-light) !important;
            }
    </style>
</head>
<body>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4 header-section flex-wrap gap-3">
            <a href="/LandingPage/Index" class="back-link text-decoration-none d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left fs-5"></i> Back to Dashboard
            </a>
            <h2 class="m-0">User Management</h2>
            <span class="badge bg-soft-primary text-primary px-3 py-2 fs-6">
                Total Users: @Model.Count()
            </span>
        </div>

        <div class="card">
            <div class="card-body">
                <table id="usersTable" class="table table-hover align-middle" style="width:100%">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Joined Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td><strong>@user.full_name</strong></td>
                                <td>@user.username</td>
                                <td>
                                    <span class="badge badge-role">@user.role</span>
                                </td>
                                <td>@user.created_at.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (user.is_approved)
                                    {
                                        <span class="status-badge status-approved">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!user.is_approved)
                                    {
                                        <button class="btn btn-success btn-sm approve-btn btn-approve" data-id="@user.id">
                                            <i class="bi bi-check-circle me-1"></i> Approve
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                            <i class="bi bi-check2-circle me-1"></i> Approved
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables + Bootstrap 5 + Responsive + Buttons + Dependencies -->
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap5.min.js"></script>

    <!-- Buttons & Export Dependencies -->
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable with Buttons
            $('#usersTable').DataTable({
                dom: 'Blfrtip',
                buttons: [
                    {
                        extend: 'copy',
                        text: '<i class="bi bi-clipboard me-1"></i> Copy',
                        className: 'dt-button'
                    },
                    {
                        extend: 'csv',
                        text: '<i class="bi bi-filetype-csv me-1"></i> CSV',
                        className: 'dt-button'
                    },
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-excel me-1"></i> Excel',
                        className: 'dt-button'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-earmark-pdf me-1"></i> PDF',
                        className: 'dt-button'
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer me-1"></i> Print',
                        className: 'dt-button'
                    }
                ],
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                language: {
                    search: "Filter:",
                    lengthMenu: "Show _MENU_ users",
                    info: "Showing _START_ to _END_ of _TOTAL_ users",
                    infoEmpty: "No users found",
                    infoFiltered: "(filtered from _MAX_ total users)",
                    paginate: {
                        first: '<i class="bi bi-chevron-bar-left"></i>',
                        last: '<i class="bi bi-chevron-bar-right"></i>',
                        next: '<i class="bi bi-chevron-right"></i>',
                        previous: '<i class="bi bi-chevron-left"></i>'
                    }
                }
            });

            // Approve button AJAX
            $(document).on('click', '.approve-btn', function () {
                var btn = $(this);
                var userId = btn.data('id');

                if (confirm('Are you sure you want to approve this user?')) {
                    $.post('/LandingPage/ApproveUser', { userId: userId }, function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Failed to approve user: ' + (response.message || 'Unknown error'));
                        }
                    }).fail(function () {
                        alert('Error connecting to server.');
                    });
                }
            });
        });
    </script>

</body>
</html>