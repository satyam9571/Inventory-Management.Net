@model StoreManagement.Common.DTOs.StockEntryDto
@Html.AntiForgeryToken()
@using StoreManagement.Common.DTOs
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers



<form id="createForm">
    <div class="mb-3">
        <label asp-for="ProductId" class="form-label">Product ID</label>
        <input asp-for="ProductId" class="form-control" required />
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" type="number" min="1" required />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EntryType" class="form-label">Entry Type</label>
        <input asp-for="EntryType" class="form-control" required />
        <span asp-validation-for="EntryType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EntryDate" class="form-label">Entry Date</label>
        <input asp-for="EntryDate" class="form-control" type="datetime-local" required />
        <span asp-validation-for="EntryDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UnitPrice" class="form-label">Unit Price</label>
        <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" required />
        <span asp-validation-for="UnitPrice" class="text-danger"></span>
    </div>

    <div class="text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Add Entry</button>
    </div>
</form>