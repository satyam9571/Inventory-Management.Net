@{
    ViewData["Title"] = "Barcode Stock Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .page-card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.08);
        }

        .table td, .table th {
            vertical-align: middle;
        }
    </style>
}

<!-- ================= HEADER ================= -->

<div class="mb-4">
    <h3 class="fw-semibold">
        <i class="bi bi-upc-scan text-primary me-2"></i>
        Barcode Stock Entry
    </h3>
</div>

<!-- ================= FORM CARD ================= -->

<div class="page-card mb-4">

    <div class="row g-3 align-items-end">

        <div class="col-md-4">
            <label class="form-label fw-semibold">Barcode</label>

            <div class="input-group">

                <input type="text"
                       id="barcode"
                       class="form-control"
                       placeholder="Enter or Scan Barcode">

                <button class="btn btn-outline-primary"
                        type="button"
                        onclick="openScanner()">
                    <i class="bi bi-upc-scan"></i>
                </button>

                <button class="btn btn-success"
                        type="button"
                        onclick="saveByBarcode()">
                    <i class="bi bi-plus-circle me-1"></i> Add Stock
                </button>

            </div>
        </div>

    </div>

</div>

<!-- ================= SCANNER MODAL ================= -->

<div id="scannerModal"
     style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
            background:rgba(0,0,0,0.7);z-index:9999;
            justify-content:center;align-items:center;">

    <div style="background:#fff;padding:15px;border-radius:10px;width:320px;">

        <h6 class="mb-2">Scan Barcode</h6>

        <video id="cameraPreview"
               autoplay
               playsinline
               style="width:100%;border-radius:8px;">
        </video>

        <button class="btn btn-danger w-100 mt-2"
                onclick="closeScanner()">
            Close
        </button>

    </div>
</div>

<!-- ================= SCRIPTS ================= -->

<script src="https://unpkg.com/@@zxing/library@0.20.0"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    // ZXING OBJECT
    let codeReader = new ZXing.BrowserMultiFormatReader();

    // OPEN CAMERA
    function openScanner() {

        document.getElementById("scannerModal").style.display = "flex";

        codeReader.decodeFromVideoDevice(
            null,
            "cameraPreview",
            (result, err) => {

                if (result) {

                    document.getElementById("barcode").value =
                        result.text;

                    Swal.fire({
                        icon: 'success',
                        title: 'Scanned!',
                        text: result.text,
                        timer: 1200,
                        showConfirmButton: false
                    });

                    closeScanner();
                }
            }
        );
    }

    // CLOSE CAMERA
    function closeScanner() {
        codeReader.reset();
        document.getElementById("scannerModal").style.display = "none";
    }

    // SEND TO BACKEND
    function saveByBarcode() {

        let barcode = $('#barcode').val();

        if (barcode === "") {

            Swal.fire(
                "Error",
                "Please scan or enter barcode",
                "error"
            );

            return;
        }

                    $.ajax({
                        url: '/StockEntries/SaveByBarcode',
                        type: 'POST',
                        data: { barcode: barcode },

                           success: function (res) {

                    if (res.success) {

                        Swal.fire(
                            "Success",
                            res.message,
                            "success"
                        );

                        $('#barcode').val('');

                    } else {

                        Swal.fire(
                            "Error",
                            res.message,
                            "error"
                        );
                    }
                }
                ,

            error: function () {

                Swal.fire(
                    "Error",
                    "Server Error",
                    "error"
                );
            }
        });
    }

</script>
